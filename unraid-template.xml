<?xml version="1.0"?>
<Container version="2">
  <Name>Dynamic Power Manager</Name>
  <Repository>REPLACE_WITH_YOUR_IMAGE:latest</Repository>
  <Registry>https://hub.docker.com/</Registry>
  <Network>bridge</Network>
  <Privileged>true</Privileged>
  <Support>http://[IP]:8787</Support>
  <Project>https://example.invalid/dynamic-power-manager</Project>
  <Overview>Dynamic Power Manager for Unraid: schedule CPU power profiles and automatically override them when Docker/game/media workloads are active.</Overview>
  <WebUI>http://[IP]:[PORT:8787]</WebUI>
  <Icon>https://raw.githubusercontent.com/linuxserver/docker-templates/master/lscr.io/img/linuxserver-logo.png</Icon>
  <Config Name="Web UI" Target="8787" Default="8787" Mode="tcp" Description="Web interface port" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/dynamic-power-manager" Mode="rw" Description="Persistent configuration and history" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/dynamic-power-manager</Config>
  <Config Name="Host sysfs" Target="/sys" Default="/sys" Mode="rw" Description="Host CPU sysfs access" Type="Path" Display="advanced-hide" Required="true" Mask="false">/sys</Config>
  <Config Name="Docker Socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Inspect Docker containers" Type="Socket" Display="advanced-hide" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Timezone" Target="TZ" Default="Europe/Rome" Description="Timezone" Type="Variable" Display="advanced-hide" Required="true" Mask="false">Europe/Rome</Config>
  <Config Name="DPM_DATA_DIR" Target="DPM_DATA_DIR" Default="/data" Description="Internal data path" Type="Variable" Display="advanced-hide" Required="true" Mask="false">/data</Config>
</Container>
