#!/bin/bash
PIDFILE=/var/run/powerpilot.pid
ENGINE=/usr/local/emhttp/plugins/powerpilot/src/engine.php
PHP=/usr/bin/php
start() {
  if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "PowerPilot is already running."; return 0; fi
  if [ ! -x "$PHP" ] || [ ! -r "$ENGINE" ]; then echo "PowerPilot PHP runtime or engine is missing." >&2; return 1; fi
  nohup "$PHP" "$ENGINE" daemon >> /var/log/powerpilot.log 2>&1 </dev/null &
  echo $! > "$PIDFILE"
  sleep 1
  kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}
stop() {
  if [ -s "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE")"; kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    kill -9 "$pid" 2>/dev/null || true; rm -f "$PIDFILE"
  fi
}
status() {
  if [ -s "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then echo "PowerPilot running (PID $(cat "$PIDFILE"))."; return 0; fi
  echo "PowerPilot stopped."; return 1
}
case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac