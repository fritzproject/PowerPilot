<style>
.pp-wrap{max-width:1420px;margin:18px auto;padding:0 18px;color:#e8edf5}.pp-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.pp-card{background:#20242b;border:1px solid #373d47;border-radius:9px;padding:16px;margin:12px 0}.pp-card h3{margin:0 0 12px}.pp-kpi{font-size:24px;font-weight:700;margin-top:5px}.pp-muted{color:#aeb7c4}.pp-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.pp-field{display:flex;flex-direction:column;gap:4px;margin:5px 0;min-width:115px;flex:1}.pp-field input,.pp-field select{background:#11151b;color:#f4f6fa;border:1px solid #454c58;border-radius:4px;padding:7px}.pp-btn{border:1px solid #596477;border-radius:5px;background:#303946;color:#fff;padding:7px 11px;cursor:pointer}.pp-btn:hover{background:#3a485b}.pp-danger{background:#612e34}.pp-table{width:100%;border-collapse:collapse}.pp-table th,.pp-table td{text-align:left;padding:8px;border-bottom:1px solid #393f49;vertical-align:top}.pp-nic-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px}.pp-nic{border:1px solid #3a424e;border-radius:6px;padding:9px}.pp-condition{border:1px solid #3a424e;border-radius:6px;padding:10px;margin:8px 0}.pp-banner{padding:10px;border-radius:5px;background:#303946;margin:8px 0}.pp-ok{color:#6ee7a1}.pp-warn{color:#ffd166}.pp-err{color:#ff8585}.pp-days label{margin-right:7px;white-space:nowrap}.pp-small{font-size:12px}@media(max-width:900px){.pp-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.pp-grid{grid-template-columns:1fr}.pp-table{font-size:12px}}
</style>
<style>
.pp-condition-hint{color:#aeb7c4;font-size:12px;margin:-3px 0 8px}
.pp-hidden{display:none!important}
</style>
<div class="pp-wrap">
  <div class="pp-row"><div><h1>PowerPilot</h1><div class="pp-muted">Controllo profili CPU · Unraid 7.2</div></div><div style="margin-left:auto" class="pp-row"><button class="pp-btn" onclick="PP.refresh()">Aggiorna</button><button class="pp-btn" onclick="PP.apply('performance')">Performance ora</button><button class="pp-btn" onclick="PP.apply('power_super_save')">Super Save ora</button></div></div>
  <div id="pp-message" class="pp-banner" style="display:none"></div>
  <div class="pp-grid">
    <div class="pp-card"><div class="pp-muted">Profilo selezionato</div><div id="pp-profile" class="pp-kpi">—</div><div id="pp-reason" class="pp-muted"></div></div>
    <div class="pp-card"><div class="pp-muted">Base programmata</div><div id="pp-base" class="pp-kpi">—</div><div id="pp-base-reason" class="pp-muted"></div></div>
    <div class="pp-card"><div class="pp-muted">CPU / memoria</div><div id="pp-cpu" class="pp-kpi">—</div><div id="pp-memory" class="pp-muted"></div></div>
    <div class="pp-card"><div class="pp-muted">I/O / rete</div><div id="pp-io" class="pp-kpi">—</div><div id="pp-net" class="pp-muted"></div></div>
  </div>
  <div class="pp-card"><div class="pp-row"><b>Modalità</b><span id="pp-mode"></span><span id="pp-manual" class="pp-muted"></span><span class="pp-muted">Prossima valutazione: <span id="pp-next"></span></span><button id="pp-enabled-button" class="pp-btn" onclick="PP.toggleEnabled()">Pausa automazione</button><span class="pp-muted" style="margin-left:auto">Kernel: <span id="pp-current"></span></span></div><div id="pp-error" class="pp-err"></div></div>
  <div class="pp-card"><h3>Impostazioni</h3><div class="pp-row"><div class="pp-field"><label>Profilo base</label><select id="pp-default-profile"></select></div><div class="pp-field"><label>Dwell minimo (secondi)</label><input id="pp-dwell" type="number" min="0" value="300"></div><div class="pp-field"><label>Intervallo controllo (secondi)</label><input id="pp-interval" type="number" min="2" value="10"></div><button class="pp-btn" onclick="PP.saveSettings()">Salva impostazioni</button></div></div>
  <div class="pp-card"><h3>Schedule</h3><div class="pp-table-wrap"><table class="pp-table"><thead><tr><th>Giorni (lun=0)</th><th>Da</th><th>A</th><th>Profilo</th><th></th></tr></thead><tbody id="pp-schedules"></tbody></table></div>
    <h4 id="pp-schedule-title">Aggiungi intervallo</h4><div class="pp-row"><div class="pp-field"><label>Giorni</label><div id="pp-days" class="pp-days"></div></div><div class="pp-field"><label>Inizio</label><input id="pp-start" type="time" value="18:00"></div><div class="pp-field"><label>Fine</label><input id="pp-end" type="time" value="06:00"></div><div class="pp-field"><label>Profilo</label><select id="pp-s-profile"></select></div><button class="pp-btn" onclick="PP.saveSchedule()">Salva schedule</button><button class="pp-btn" onclick="PP.cancelSchedule()">Annulla</button></div>
  </div>
  <div class="pp-card"><h3>Regole e condizioni</h3><table class="pp-table"><thead><tr><th>Priorità</th><th>Regola</th><th>Match</th><th>Condizioni</th><th>Profilo</th><th></th></tr></thead><tbody id="pp-rules"></tbody></table>
    <h4 id="pp-rule-title">Aggiungi regola</h4><input id="pp-rule-id" type="hidden"><div class="pp-row"><div class="pp-field"><label>Nome</label><input id="pp-rule-name" maxlength="80"></div><div class="pp-field"><label>Priorità</label><input id="pp-rule-priority" type="number" value="100"></div><div class="pp-field"><label>Profilo</label><select id="pp-rule-profile"></select></div><div class="pp-field"><label>Hold (secondi)</label><input id="pp-rule-hold" type="number" min="0" value="10"></div><div class="pp-field"><label>Condizioni</label><select id="pp-rule-match"><option value="all">Tutte (AND)</option><option value="any">Una qualsiasi (OR)</option></select></div><label><input id="pp-rule-enabled" type="checkbox" checked> Attiva</label></div>
    <div id="pp-conditions"></div><button class="pp-btn" onclick="PP.addCondition()">Aggiungi condizione</button> <button class="pp-btn" onclick="PP.saveRule()">Salva regola</button> <button class="pp-btn" onclick="PP.cancelRule()">Annulla</button>
  </div>
  <div class="pp-card"><h3>Controllo manuale e sicurezza</h3><div class="pp-row"><div class="pp-field"><label>Override manuale</label><select id="pp-manual-profile"><option value="">Nessuno</option></select></div><div class="pp-field"><label>Durata (minuti, 0 = senza scadenza)</label><input id="pp-manual-duration" type="number" min="0" value="60"></div><button class="pp-btn" onclick="PP.setManual()">Imposta override</button><button class="pp-btn" onclick="PP.clearManual()">Rimuovi override</button><button id="pp-live-button" class="pp-btn" onclick="PP.toggleMode()">Attiva controllo live…</button></div><p class="pp-muted pp-small">In dry-run le regole vengono valutate e registrate, ma il controller non modifica governor o EPP. Le modifiche live riguardano solo questi due parametri.</p></div>
  <div class="pp-card">
    <h3>Rete: TCP e affinità IRQ delle NIC</h3>
    <p class="pp-muted">Queste modifiche sono separate dai profili CPU. Entrambe sono disattivate inizialmente; salva le opzioni e usa il pulsante live dedicato per applicarle.</p>
    <div class="pp-row">
      <label><input id="pp-tcp-enabled" type="checkbox"> Ottimizza buffer TCP in base alla velocità delle NIC fisiche</label>
      <label><input id="pp-irq-enabled" type="checkbox"> Distribuisci IRQ e code TX sui CPU selezionati</label>
    </div>
    <div class="pp-field"><label>CPU da riservare (separati da virgola; 0 è riservato per default)</label><input id="pp-network-reserved" value="0"></div>
    <h4>Interfacce fisiche</h4>
    <div id="pp-network-interfaces" class="pp-nic-list"></div>
    <div class="pp-row">
      <button class="pp-btn" onclick="PP.saveNetworkSettings()">Salva impostazioni rete</button>
      <button id="pp-network-live-button" class="pp-btn pp-danger" onclick="PP.toggleNetworkMode()">Attiva tuning rete live</button>
      <span id="pp-network-status" class="pp-muted"></span>
    </div>
    <div class="pp-row">
      <div class="pp-field"><b>Piano TCP</b><div id="pp-tcp-plan" class="pp-small"></div></div>
      <div class="pp-field"><b>Piano IRQ / XPS</b><div id="pp-irq-plan" class="pp-small"></div></div>
    </div>
    <p class="pp-warn pp-small">La gestione IRQ può influire sulla rete. Verifica prima in dry-run. AutoTweak deve essere disattivato o rimosso: PowerPilot blocca l’attivazione live se lo rileva.</p>
  </div>  <div class="pp-card"><h3>Storico decisioni</h3><table class="pp-table"><thead><tr><th>Ora</th><th>Profilo</th><th>Applicato</th><th>Motivo</th></tr></thead><tbody id="pp-history"></tbody></table></div>
</div>
<script>
window.PowerPilotPage=(function(){
  const endpoint='/plugins/powerpilot/api.php'; let data=null, settingsLoaded=false, networkInputsInitialized=false, editingSchedule=-1, editingRule=null;
  const profiles=['performance','balanced','power_save','power_super_save'], labels={performance:'Performance',balanced:'Balanced',power_save:'Power Save',power_super_save:'Power Super Save'};
  const conditionTypes={
    cpu_busy_gte:'CPU host sopra soglia',
    load1_gte:'Carico host (load average)',
    memory_used_gte:'Memoria usata sopra soglia',
    io_mbps_gte:'Attività disco sopra soglia',
    network_mbps_gte:'Traffico di rete sopra soglia',
    docker_running:'Container Docker in esecuzione',
    docker_cpu_gte:'CPU container Docker sopra soglia',
    process_running:'Processo presente',
    process_cpu_gte:'CPU processo sopra soglia',
    tcp_connections_gte:'Connessioni TCP su una porta',
    game_players_gte:'Giocatori online (query server)'
  };
  const types=Object.keys(conditionTypes);
  const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  function say(message,error=false){const e=document.getElementById('pp-message');e.textContent=message;e.className='pp-banner '+(error?'pp-err':'pp-ok');e.style.display='block';setTimeout(()=>e.style.display='none',6000)}
  async function request(action,payload={}){const body=new URLSearchParams({action,csrf_token:data?.csrf_token||'',payload:JSON.stringify(payload)});const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','Accept':'application/json'},body,credentials:'same-origin'});const j=await r.json();if(!r.ok)throw new Error(j.error||'Richiesta non riuscita');return j}
  async function refresh(){try{const r=await fetch(endpoint,{headers:{'Accept':'application/json'},credentials:'same-origin'});data=await r.json();if(!r.ok)throw new Error(data.error);render();renderNetwork()}catch(e){say(e.message,true)}}
  function profileOptions(selected){return profiles.map(p=>`<option value="${p}" ${p===selected?'selected':''}>${labels[p]}</option>`).join('')}
  function render(){const s=data.state||{},m=s.metrics||{};document.getElementById('pp-profile').textContent=labels[s.active_profile]||'In attesa';document.getElementById('pp-reason').textContent=s.last_reason||'—';document.getElementById('pp-base').textContent=labels[data.base_profile]||data.base_profile;document.getElementById('pp-base-reason').textContent=data.base_reason;document.getElementById('pp-cpu').textContent=(m.cpu_busy||0).toFixed(1)+'%';document.getElementById('pp-memory').textContent='Memoria '+(m.memory_used||0).toFixed(1)+'% · load '+(m.load1||0).toFixed(2);document.getElementById('pp-io').textContent=(m.io_mbps||0).toFixed(1)+' MB/s';document.getElementById('pp-net').textContent=(m.network_mbps||0).toFixed(1)+' Mb/s';document.getElementById('pp-mode').innerHTML=data.config.dry_run?'<b class="pp-warn">DRY-RUN</b>':'<b class="pp-err">LIVE</b>';document.getElementById('pp-current').textContent=(data.current.governor||'?')+' / '+(data.current.epp||'?');document.getElementById('pp-manual').textContent=data.config.manual_override?'Override: '+(labels[data.config.manual_override.profile]||''):'Automatico';document.getElementById('pp-error').textContent=s.config_error||'';document.getElementById('pp-live-button').textContent=data.config.dry_run?'Attiva controllo live…':'Torna a dry-run';document.getElementById('pp-enabled-button').textContent=data.config.enabled?'Pausa automazione':'Riattiva automazione';document.getElementById('pp-next').textContent=s.next_reevaluation?new Date(s.next_reevaluation*1000).toLocaleTimeString():'—';
    ['pp-s-profile','pp-rule-profile','pp-default-profile'].forEach(id=>{if(!document.querySelector('#'+id+' option'))document.getElementById(id).innerHTML=profileOptions(profiles[0])});if(!settingsLoaded){document.getElementById('pp-default-profile').value=data.config.default_profile;document.getElementById('pp-dwell').value=data.config.min_dwell_sec;document.getElementById('pp-interval').value=data.config.check_interval_sec;settingsLoaded=true;}const manualSelect=document.getElementById('pp-manual-profile'),manualSelected=manualSelect.value;manualSelect.innerHTML='<option value="">Nessuno</option>'+profileOptions(data.config.manual_override?.profile||'');if(manualSelected)manualSelect.value=manualSelected;
    document.getElementById('pp-schedules').innerHTML=(data.config.schedule||[]).map((x,i)=>`<tr><td>${esc(x.days.join(', '))}</td><td>${esc(x.start)}</td><td>${esc(x.end)}</td><td>${esc(labels[x.profile]||x.profile)}</td><td><button class="pp-btn" onclick="PowerPilotPage.editSchedule(${i})">Modifica</button> <button class="pp-btn pp-danger" onclick="PowerPilotPage.deleteSchedule(${i})">Elimina</button></td></tr>`).join('');
    document.getElementById('pp-rules').innerHTML=(data.config.rules||[]).slice().sort((a,b)=>b.priority-a.priority).map(r=>`<tr><td>${r.priority}</td><td>${esc(r.name||r.id)}${r.enabled?'':' <span class="pp-muted">(spenta)</span>'}</td><td>${esc(r.match||'all')}</td><td>${r.conditions.length} condizione/i</td><td>${esc(labels[r.profile]||r.profile)}</td><td><button class="pp-btn" onclick="PowerPilotPage.editRule('${esc(r.id)}')">Modifica</button> <button class="pp-btn pp-danger" onclick="PowerPilotPage.deleteRule('${esc(r.id)}')">Elimina</button></td></tr>`).join('');
    document.getElementById('pp-history').innerHTML=(data.history||[]).map(e=>`<tr><td>${esc(e.ts)}</td><td>${esc(labels[e.profile]||e.profile)}</td><td>${e.applied?'Sì':e.dry_run?'Dry-run':'No'}</td><td>${esc(e.reason)}</td></tr>`).join('')}
  function renderNetwork(){
    const network=data.config.network||{}, plan=data.network_plan||{}, status=data.state.network_status||{};
    const interfaces=plan.available_interfaces||[];
    if(!networkInputsInitialized){
      document.getElementById('pp-tcp-enabled').checked=Boolean(network.tcp_enabled);
      document.getElementById('pp-irq-enabled').checked=Boolean(network.irq_enabled);
      document.getElementById('pp-network-reserved').value=(network.reserved_cpus||[0]).join(',');
      document.getElementById('pp-network-interfaces').innerHTML=interfaces.map(nic=>{
        const checked=(network.interfaces||[]).includes(nic.name)?'checked':'';
        const speed=nic.speed_mbps?`${nic.speed_mbps} Mb/s`:'velocità sconosciuta';
        return `<label class="pp-nic"><input class="pp-nic-check" type="checkbox" value="${esc(nic.name)}" ${checked}> <b>${esc(nic.name)}</b> · ${esc(nic.driver)} · ${speed} · ${nic.rx_queues} RX / ${nic.tx_queues} TX</label>`;
      }).join('')||'<span class="pp-muted">Nessuna NIC fisica rilevata.</span>';
      networkInputsInitialized=true;
    }

    const live=Boolean(network.live_enabled);
    const liveButton=document.getElementById('pp-network-live-button');
    liveButton.textContent=live?'Disattiva tuning rete e ripristina':'Attiva tuning rete live';
    liveButton.disabled=!live&&Boolean(plan.autotweak_detected);
    const result=status.errors?.length?` — errori: ${status.errors.join('; ')}`:'';
    document.getElementById('pp-network-status').textContent=plan.autotweak_detected
      ?'AutoTweak rilevato: tuning live bloccato.'
      :live?(status.applied?'Tuning live applicato.':'Tuning live in attesa di applicazione.')+result
      :'Anteprima: nessuna modifica al kernel.';

    const tcpRows=Object.entries(plan.tcp?.settings||{}).map(([key,value])=>`<tr><td>${esc(key)}</td><td>${esc(value)}</td><td>${esc(plan.tcp.current?.[key]??'non disponibile')}</td></tr>`).join('');
    document.getElementById('pp-tcp-plan').innerHTML=`Velocità fisica massima: ${plan.tcp?.max_speed_mbps||0} Mb/s<table class="pp-table"><thead><tr><th>Parametro</th><th>Proposto</th><th>Attuale</th></tr></thead><tbody>${tcpRows}</tbody></table>`;
    const irqRows=(plan.irq?.interfaces||[]).map(nic=>{
      const irq=nic.irq_assignments.map(x=>`IRQ ${x.irq} → CPU ${x.cpu??'—'}`).join(', ')||'IRQ non rilevati';
      const tx=nic.tx_assignments.map(x=>`TX ${x.queue} → CPU ${x.cpu??'—'}`).join(', ')||'nessuna coda TX';
      const warnings=nic.warnings.map(esc).join('; ');
      return `<tr><td>${esc(nic.name)}</td><td>${esc(irq)}</td><td>${esc(tx)}</td><td>${warnings}</td></tr>`;
    }).join('');
    document.getElementById('pp-irq-plan').innerHTML=`CPU riservate: ${esc((plan.irq?.reserved_cpus||[]).join(', '))}<table class="pp-table"><thead><tr><th>NIC</th><th>IRQ</th><th>XPS</th><th>Note</th></tr></thead><tbody>${irqRows||'<tr><td colspan="4">Seleziona una NIC per vedere il piano.</td></tr>'}</tbody></table>`;
  }
  async function saveNetworkSettings(){
    const reservedText=document.getElementById('pp-network-reserved').value.trim();
    const reserved=reservedText===''?[]:reservedText.split(',').map(value=>value.trim());
    if(reserved.some(value=>!/^\d+$/.test(value)))return say('La lista CPU deve contenere solo numeri separati da virgole.',true);
    data.config.network=data.config.network||{};
    data.config.network.tcp_enabled=document.getElementById('pp-tcp-enabled').checked;
    data.config.network.irq_enabled=document.getElementById('pp-irq-enabled').checked;
    data.config.network.interfaces=[...document.querySelectorAll('.pp-nic-check:checked')].map(input=>input.value);
    data.config.network.reserved_cpus=reserved.map(Number);
    try{await request('save_config',{config:data.config});networkInputsInitialized=false;await refresh();say('Impostazioni rete salvate; il piano è ancora in dry-run.')}catch(e){say(e.message,true)}
  }
  async function toggleNetworkMode(){
    const live=Boolean(data.config.network?.live_enabled);
    if(!live&&data.network_plan?.autotweak_detected)return say('Disattiva o rimuovi AutoTweak prima di applicare il tuning rete.',true);
    const prompt=live?'Ripristinare i valori di rete salvati prima dell’attivazione?':'PowerPilot modificherà parametri TCP e affinità IRQ/XPS delle NIC selezionate. Continuare?';
    if(!confirm(prompt))return;
    try{const result=await request('network_mode',{mode:live?'dry_run':'live',confirmed:true});await refresh();say(live?'Valori di rete ripristinati.':result.applied?'Tuning rete applicato.':'Applicazione incompleta: '+(result.errors||[]).join('; '),!live&&!result.applied)}catch(e){say(e.message,true)}
  }  function renderDays(selected=[]){document.getElementById('pp-days').innerHTML=['Lun','Mar','Mer','Gio','Ven','Sab','Dom'].map((n,i)=>`<label><input type="checkbox" value="${i}" ${selected.includes(i)?'checked':''}>${n}</label>`).join('')}
  function saveSchedule(){const days=[...document.querySelectorAll('#pp-days input:checked')].map(x=>Number(x.value));if(!days.length)return say('Seleziona almeno un giorno.',true);const row={days,start:document.getElementById('pp-start').value,end:document.getElementById('pp-end').value,profile:document.getElementById('pp-s-profile').value};if(!row.start||!row.end)return say('Inserisci entrambi gli orari.',true);if(editingSchedule>=0)data.config.schedule[editingSchedule]=row;else data.config.schedule.push(row);persist('Schedule aggiornata.')}
  function editSchedule(i){const x=data.config.schedule[i];editingSchedule=i;document.getElementById('pp-start').value=x.start;document.getElementById('pp-end').value=x.end;document.getElementById('pp-s-profile').value=x.profile;renderDays(x.days);document.getElementById('pp-schedule-title').textContent='Modifica intervallo'}
  function cancelSchedule(){editingSchedule=-1;document.getElementById('pp-start').value='18:00';document.getElementById('pp-end').value='06:00';renderDays([0,1,2,3,4,5,6]);document.getElementById('pp-schedule-title').textContent='Aggiungi intervallo'}
  function deleteSchedule(i){if(!confirm('Eliminare questo intervallo?'))return;data.config.schedule.splice(i,1);persist('Schedule eliminata.')}
  function updateConditionFields(box){
    const type=box.querySelector('.ct').value;
    const isDocker=type==='docker_running'||type==='docker_cpu_gte';
    const isProcess=type==='process_running'||type==='process_cpu_gte';
    const isPresence=type==='docker_running'||type==='process_running';
    const isTcp=type==='tcp_connections_gte';
    const isGame=type==='game_players_gte';
    const isCpu=type==='cpu_busy_gte'||type==='docker_cpu_gte'||type==='process_cpu_gte';
    const isMemory=type==='memory_used_gte';
    const isLoad=type==='load1_gte';
    const isDisk=type==='io_mbps_gte';
    const isNetwork=type==='network_mbps_gte';
    const protocol=box.querySelector('.protocol').value;
    const show=(selector,visible)=>box.querySelector(selector).classList.toggle('pp-hidden',!visible);

    show('.pattern-field',isDocker||isProcess);
    show('.value-field',!isPresence);
    show('.port-field',isTcp||isGame);
    show('.protocol-field',isGame);
    show('.host-field',isGame);
    show('.password-field',isGame&&protocol==='minecraft_rcon');

    box.querySelector('.pattern-label').textContent=isDocker
      ?'Nome container (puoi usare una regex)'
      :'Nome processo (puoi usare una regex)';
    box.querySelector('.pattern').placeholder=isDocker?'Es. plex oppure plex.*':'Es. java oppure minecraft.*';

    let valueLabel='Soglia';
    let hint='La condizione si attiva quando il valore raggiunge o supera la soglia.';
    if(isCpu){valueLabel='Utilizzo CPU (%)';hint='Utilizzo CPU oltre il quale attivare la regola.';}
    if(isMemory){valueLabel='Memoria utilizzata (%)';hint='Memoria usata oltre la quale attivare la regola.';}
    if(isLoad){valueLabel='Load average a 1 minuto';hint='Carico host oltre il quale attivare la regola.';}
    if(isDisk){valueLabel='Lettura e scrittura disco (MB/s)';hint='Attività complessiva dei dischi oltre la quale attivare la regola.';}
    if(isNetwork){valueLabel='Traffico rete (Mb/s)';hint='Traffico complessivo host oltre il quale attivare la regola.';}
    if(isTcp){valueLabel='Connessioni minime';hint='Numero minimo di connessioni TCP attive sulla porta.';}
    if(isGame){valueLabel='Giocatori minimi';hint='Numero minimo di giocatori restituito dalla query.';}
    if(isDocker){hint=isPresence?'Si attiva quando il container corrispondente è in esecuzione.':'Si attiva quando il container supera la soglia CPU.';}
    if(isProcess){hint=isPresence?'Si attiva quando il processo corrispondente è presente.':'Si attiva quando il processo supera la soglia CPU.';}
    if(isGame&&protocol==='minecraft_rcon')hint+=' Inserisci la password RCON del server.';

    box.querySelector('.value-label').textContent=valueLabel;
    box.querySelector('.condition-hint').textContent=hint;
  }
  function addCondition(value={}){
    const box=document.createElement('div');
    const selectedType=types.includes(value.type)?value.type:'cpu_busy_gte';
    box.className='pp-condition';
    box.innerHTML=`
      <div class="pp-row">
        <div class="pp-field">
          <label>Quando si verifica questa condizione</label>
          <select class="ct">${types.map(type=>`<option value="${type}" ${type===selectedType?'selected':''}>${conditionTypes[type]}</option>`).join('')}</select>
        </div>
        <button class="pp-btn pp-danger remove-condition" type="button">Rimuovi condizione</button>
      </div>
      <div class="condition-hint pp-condition-hint"></div>
      <div class="pp-row">
        <div class="pp-field pattern-field">
          <label class="pattern-label">Nome container</label>
          <input class="pattern" value="${esc(value.container||value.process||'')}">
        </div>
        <div class="pp-field value-field">
          <label class="value-label">Soglia</label>
          <input class="value" type="number" min="0" step="any" value="${esc(value.value??1)}">
        </div>
        <div class="pp-field port-field">
          <label>Porta</label>
          <input class="port" type="number" min="1" max="65535" value="${esc(value.port||value.query?.port||'')}">
        </div>
        <div class="pp-field protocol-field">
          <label>Protocollo query</label>
          <select class="protocol">
            <option value="steam_a2s" ${value.query?.protocol!=='minecraft_rcon'?'selected':''}>Steam A2S</option>
            <option value="minecraft_rcon" ${value.query?.protocol==='minecraft_rcon'?'selected':''}>Minecraft RCON</option>
          </select>
        </div>
        <div class="pp-field host-field">
          <label>Indirizzo o nome host</label>
          <input class="host" placeholder="Es. 192.168.1.50" value="${esc(value.query?.host||'')}">
        </div>
        <div class="pp-field password-field">
          <label>Password RCON</label>
          <input class="password" type="password" autocomplete="new-password" value="${esc(value.query?.password||'')}">
        </div>
      </div>`;

    box.querySelector('.ct').addEventListener('change',()=>updateConditionFields(box));
    box.querySelector('.protocol').addEventListener('change',()=>updateConditionFields(box));
    box.querySelector('.remove-condition').addEventListener('click',()=>box.remove());
    document.getElementById('pp-conditions').appendChild(box);
    updateConditionFields(box);
  }
  function readConditions(){
    return [...document.querySelectorAll('.pp-condition')].map(box=>{
      const type=box.querySelector('.ct').value;
      const pattern=box.querySelector('.pattern').value.trim();
      const value=Number(box.querySelector('.value').value||0);
      const port=Number(box.querySelector('.port').value||0);
      if(type==='docker_running')return{type,container:pattern};
      if(type==='docker_cpu_gte')return{type,container:pattern,value};
      if(type==='process_running')return{type,process:pattern};
      if(type==='process_cpu_gte')return{type,process:pattern,value};
      if(type==='tcp_connections_gte')return{type,port,value};
      if(type==='game_players_gte')return{type,value,query:{protocol:box.querySelector('.protocol').value,host:box.querySelector('.host').value.trim(),port,password:box.querySelector('.password').value}};
      return{type,value};
    });
  }
  function validateConditions(conditions){
    for(const condition of conditions){
      if((condition.type.startsWith('docker_')||condition.type.startsWith('process_'))&&!condition.container&&!condition.process){
        return 'Inserisci il nome del container o del processo da controllare.';
      }
      if(condition.type==='tcp_connections_gte'&&(condition.port<1||condition.port>65535)){
        return 'Inserisci una porta TCP compresa tra 1 e 65535.';
      }
      if(condition.type==='game_players_gte'){
        if(!condition.query.host)return 'Inserisci l’indirizzo o il nome host del server di gioco.';
        if(condition.query.port<1||condition.query.port>65535)return 'Inserisci una porta query compresa tra 1 e 65535.';
        if(condition.query.protocol==='minecraft_rcon'&&!condition.query.password)return 'Inserisci la password RCON del server Minecraft.';
      }
    }
    return '';
  }
  function saveRule(){
    const name=document.getElementById('pp-rule-name').value.trim();
    const conditions=readConditions();
    if(!name||!conditions.length)return say('Inserisci un nome e almeno una condizione.',true);
    const conditionError=validateConditions(conditions);
    if(conditionError)return say(conditionError,true);
    const id=document.getElementById('pp-rule-id').value||name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
    const row={id,name,enabled:document.getElementById('pp-rule-enabled').checked,priority:Number(document.getElementById('pp-rule-priority').value||0),profile:document.getElementById('pp-rule-profile').value,hold_sec:Number(document.getElementById('pp-rule-hold').value||0),match:document.getElementById('pp-rule-match').value,conditions};
    if(editingRule!==null){const i=data.config.rules.findIndex(rule=>rule.id===editingRule);if(i>=0)data.config.rules[i]=row;}
    else data.config.rules.push(row);
    persist('Regola salvata.');
  }
  function editRule(id){const r=data.config.rules.find(x=>x.id===id);if(!r)return;editingRule=id;document.getElementById('pp-rule-id').value=id;document.getElementById('pp-rule-name').value=r.name;document.getElementById('pp-rule-priority').value=r.priority;document.getElementById('pp-rule-profile').value=r.profile;document.getElementById('pp-rule-hold').value=r.hold_sec;document.getElementById('pp-rule-match').value=r.match||'all';document.getElementById('pp-rule-enabled').checked=r.enabled;document.getElementById('pp-conditions').innerHTML='';r.conditions.forEach(addCondition);document.getElementById('pp-rule-title').textContent='Modifica regola'}
  function cancelRule(){editingRule=null;document.getElementById('pp-rule-id').value='';document.getElementById('pp-rule-name').value='';document.getElementById('pp-rule-priority').value=100;document.getElementById('pp-rule-hold').value=10;document.getElementById('pp-rule-match').value='all';document.getElementById('pp-rule-enabled').checked=true;document.getElementById('pp-conditions').innerHTML='';addCondition();document.getElementById('pp-rule-title').textContent='Aggiungi regola'}
  function deleteRule(id){if(!confirm('Eliminare la regola?'))return;data.config.rules=data.config.rules.filter(r=>r.id!==id);persist('Regola eliminata.')}
  async function persist(message){try{await request('save_config',{config:data.config});cancelSchedule();cancelRule();await refresh();say(message)}catch(e){say(e.message,true)}}
  async function saveSettings(){data.config.default_profile=document.getElementById('pp-default-profile').value;data.config.min_dwell_sec=Number(document.getElementById('pp-dwell').value||0);data.config.check_interval_sec=Math.max(2,Number(document.getElementById('pp-interval').value||10));await persist('Impostazioni salvate.')}async function toggleEnabled(){data.config.enabled=!data.config.enabled;await persist(data.config.enabled?'Automazione riattivata.':'Automazione in pausa.')}
  async function apply(profile){try{await request('apply',{profile});await refresh();say(data.config.dry_run?'Profilo simulato in dry-run.':'Profilo richiesto applicato.')}catch(e){say(e.message,true)}}
  async function setManual(){const profile=document.getElementById('pp-manual-profile').value;if(!profile)return clearManual();const mins=Number(document.getElementById('pp-manual-duration').value||0);try{await request('manual',{profile,duration_sec:mins*60});await refresh();say('Override manuale impostato.')}catch(e){say(e.message,true)}}
  async function clearManual(){try{await request('manual',{profile:null});await refresh();say('Override rimosso.')}catch(e){say(e.message,true)}}
  async function toggleMode(){const live=data.config.dry_run;if(live&&!confirm('Tornare a dry-run?'))return;if(!live&&!confirm('ATTENZIONE: il controller modificherà governor ed EPP del server. Continuare?'))return;try{await request('mode',{mode:live?'dry_run':'live',confirmed:true});await refresh();say(live?'Dry-run attivato.':'Controllo live attivato.')}catch(e){say(e.message,true)}}
  renderDays([0,1,2,3,4,5,6]);cancelRule();refresh();setInterval(refresh,5000);
  return{refresh,saveSchedule,editSchedule,cancelSchedule,deleteSchedule,addCondition,saveRule,editRule,cancelRule,deleteRule,saveSettings,toggleEnabled,apply,setManual,clearManual,toggleMode,saveNetworkSettings,toggleNetworkMode};
})();
window.PP=window.PowerPilotPage;
</script>
