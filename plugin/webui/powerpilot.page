<?php
$enginePath = is_file(__DIR__ . '/src/engine.php') ? __DIR__ . '/src/engine.php' : __DIR__ . '/../src/engine.php';
require_once $enginePath;

use function PowerPilot\loadConfig;
use function PowerPilot\saveConfig;
use function PowerPilot\loadState;
use function PowerPilot\atomicJson;
use function PowerPilot\history;
use function PowerPilot\currentProfile;
use function PowerPilot\scheduledProfile;
use function PowerPilot\applyProfile;
use function PowerPilot\validConfig;
use function PowerPilot\networkPlan;
use function PowerPilot\networkConfigHash;
use function PowerPilot\applyNetworkPlan;
use function PowerPilot\restoreNetworkSettings;

$var = $var ?? [];
$isAjax = isset($_GET['ajax']) || isset($_SERVER['HTTP_ACCEPT']) && strpos($_SERVER['HTTP_ACCEPT'], 'application/json') !== false;
$reply = static function (array $body, int $code = 200): void { http_response_code($code); header('Content-Type: application/json; charset=utf-8'); echo json_encode($body, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE); exit; };
if ($isAjax) {
    try {
        $cfg = loadConfig();
        if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
            $input = $_POST;
            $posted = json_decode((string)($input['payload'] ?? '{}'), true);
            if (!is_array($posted)) $reply(['error'=>'Invalid request payload'],400);
            $input = array_merge($input,$posted);
            $csrf = (string)($var['csrf_token'] ?? '');
            if ($csrf === '' || !hash_equals($csrf, (string)($input['csrf_token'] ?? ''))) $reply(['error'=>'Invalid CSRF token'],403);
            $action = (string)($input['action'] ?? ''); $state = loadState();
            if ($action === 'save_config') {
                $next = $input['config'] ?? null;
                if (!is_array($next)) $reply(['error'=>'Missing config'],400);
                $next['dry_run'] = (bool)($cfg['dry_run'] ?? true);
                $next = PowerPilot\configWithDefaults($next);
                $next['network']['live_enabled'] = !empty($cfg['network']['live_enabled']);
                if (!validConfig($next,$error)) $reply(['error'=>$error],400);
                saveConfig($next); $reply(['ok'=>true]);
            }
            if ($action === 'mode') {
                if (!in_array($input['mode'] ?? '', ['dry_run','live'], true) || empty($input['confirmed'])) $reply(['error'=>'Explicit mode confirmation required'],400);
                $enableLive = $input['mode'] === 'live';
                $wasDry = !empty($cfg['dry_run']);
                $cfg['dry_run'] = !$enableLive; saveConfig($cfg);
                if ($enableLive && $wasDry) { $state['active_profile']=null; $state['last_switch']=0; $state['last_applied']=false; atomicJson(PowerPilot\STATE_FILE,$state); }
                $reply(['ok'=>true,'dry_run'=>$cfg['dry_run']]);
            }
            if ($action === 'network_mode') {
                if (!in_array($input['mode'] ?? '', ['dry_run', 'live'], true) || empty($input['confirmed'])) {
                    $reply(['error' => 'Explicit network mode confirmation required'], 400);
                }

                if ($input['mode'] === 'live') {
                    $preview = networkPlan($cfg);
                    if ($preview['autotweak_detected']) {
                        $reply(['error' => 'AutoTweak is installed. Disable or uninstall it before enabling PowerPilot network tuning.'], 409);
                    }
                    if (empty($cfg['network']['tcp_enabled']) && empty($cfg['network']['irq_enabled'])) {
                        $reply(['error' => 'Enable TCP tuning or NIC IRQ affinity and save first.'], 400);
                    }
                    if (!empty($cfg['network']['irq_enabled']) && empty($cfg['network']['interfaces'])) {
                        $reply(['error' => 'Select at least one physical NIC for IRQ affinity.'], 400);
                    }

                    $cfg['network']['live_enabled'] = true;
                    saveConfig($cfg);
                    $result = applyNetworkPlan($cfg, $state);
                    $state['network_status'] = [
                        'live_enabled' => true,
                        'applied' => $result['applied'],
                        'errors' => $result['errors'],
                        'updated_at' => date(DATE_ATOM),
                    ];
                    $state['network_status']['boot_id'] = networkReadValue('/proc/sys/kernel/random/boot_id') ?? 'unknown';
                    $state['network_status']['config_hash'] = networkConfigHash($cfg['network']);
                    atomicJson(PowerPilot\STATE_FILE, $state);
                    $reply(['ok' => true, 'applied' => $result['applied'], 'errors' => $result['errors']]);
                }

                $cfg['network']['live_enabled'] = false;
                saveConfig($cfg);
                $restore = restoreNetworkSettings($state);
                $state['network_status'] = [
                    'live_enabled' => false,
                    'applied' => empty($restore['errors']),
                    'errors' => $restore['errors'],
                    'updated_at' => date(DATE_ATOM),
                ];
                atomicJson(PowerPilot\STATE_FILE, $state);
                $reply(['ok' => true, 'restored' => $restore['restored'], 'errors' => $restore['errors']]);
            }
            if ($action === 'manual') {
                $profile=$input['profile']??null;
                if ($profile !== null && !isset($cfg['profiles'][$profile])) $reply(['error'=>'Unknown profile'],400);
                if ($profile===null) $cfg['manual_override']=null;
                else { $duration=max(0,min(604800,(int)($input['duration_sec']??0))); $cfg['manual_override']=['profile'=>$profile,'expires_at'=>$duration>0?time()+$duration:null]; }
                saveConfig($cfg); $reply(['ok'=>true]);
            }
            if ($action === 'apply') {
                $profile=(string)($input['profile']??''); if(!isset($cfg['profiles'][$profile]))$reply(['error'=>'Unknown profile'],400);
                $changed=applyProfile($profile,'manual apply',$cfg,$state,true); atomicJson(PowerPilot\STATE_FILE,$state); $reply(['ok'=>true,'changed'=>$changed,'dry_run'=>$cfg['dry_run']]);
            }
            $reply(['error'=>'Unknown action'],400);
        }
        [$base,$baseReason]=scheduledProfile($cfg,new DateTimeImmutable('now'));
        $state=loadState(); $reply(['version'=>PowerPilot\VERSION,'config'=>$cfg,'state'=>$state,'current'=>currentProfile(),'base_profile'=>$base,'base_reason'=>$baseReason,'history'=>history(100),'network_plan'=>networkPlan($cfg),'csrf_token'=>(string)($var['csrf_token']??'')]);
    } catch (Throwable $e) { $reply(['error'=>$e->getMessage()],500); }
}
?>
