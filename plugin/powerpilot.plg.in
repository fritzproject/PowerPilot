<?xml version="1.0"?>
<PLUGIN name="powerpilot" author="PowerPilot" version="@VERSION@" pluginURL="https://github.com/Fritzproject/PowerPilot/releases/latest/download/powerpilot.plg" min="7.2.0" support="https://github.com/Fritzproject/PowerPilot/issues">
  <CHANGES>
    ### @VERSION@
    - Native Unraid plugin with dry-run default.
    - CPU profiles, schedules, workload rules and game queries.
  </CHANGES>
  <FILE Name="/boot/config/plugins/powerpilot/powerpilot-@VERSION@.txz">
    <URL>https://github.com/Fritzproject/PowerPilot/releases/download/v@VERSION@/powerpilot-@VERSION@.txz</URL>
    <SHA256>@SHA256@</SHA256>
  </FILE>
  <FILE Run="upgrade">
    <INLINE>
      <![CDATA[
        if [ -x /etc/rc.d/rc.powerpilot ]; then /etc/rc.d/rc.powerpilot stop; fi
        upgradepkg --install-new /boot/config/plugins/powerpilot/powerpilot-@VERSION@.txz
        /etc/rc.d/rc.powerpilot start
      ]]>
    </INLINE>
  </FILE>
  <FILE Run="remove">
    <INLINE>
      <![CDATA[
        if [ -x /etc/rc.d/rc.powerpilot ]; then /etc/rc.d/rc.powerpilot stop; fi
        removepkg powerpilot 2>/dev/null || true
        rm -rf /usr/local/emhttp/plugins/powerpilot
        rm -f /etc/rc.d/rc.powerpilot /var/run/powerpilot.pid
      ]]>
    </INLINE>
  </FILE>
</PLUGIN>